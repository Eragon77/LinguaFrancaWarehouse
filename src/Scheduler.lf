target Python;

import FrostReactor from "../frost/src/lib/FrostReactor.lf"

preamble {=
    import json
=}

reactor Scheduler(_scheduling_instance = "models/production_plan.json") extends FrostReactor {
    state scheduling_instance = _scheduling_instance
    state my_machine_name = "warehouseunit" 
    state task_queue = {= [] =}
    state current_task = ""
    state current_tray = {= None =}

    state start_task_node = {= None =}
    state current_task_node = {= None =}
    state queue_length_node = {= None =}

    timer monitoring_loop(0, 50 msec)

    method send_next_task(out_port) {=
        task = self.task_queue.pop(0)
        self.current_task = task["name"]
        tray = task.get("tray", 0)
        
        if self.current_task_node: self.current_task_node.value = self.current_task
        if self.queue_length_node: self.queue_length_node.value = len(self.task_queue)
        
        remote_method = f"Machine/{self.current_task}"
        
        self.logger.info(f">>> Executing via Data Model: {self.current_task} tray={tray}")

        if self.start_task_node:
            try:
                res = self.start_task_node(
                    remote_machine=self.my_machine_name,
                    remote_method=remote_method,
                    tray_id=tray if tray is not None else 0
                )
                if res:
                    cid = res.return_values.get("@context_id")
                    if cid:
                        dummy_msg = self.message_builder.build_invoke_method_message(
                            correlation_id=cid,
                            target="scheduler",
                            node="Scheduler/StartTask",
                            args=[],
                            kwargs={}
                        )
                        self.protocol_mng._running_methods[cid] = (self.start_task_node, dummy_msg)
                        self.start_task_node.set_context_subscription_callback(
                            cid, self.protocol_mng._update_variable_callback
                        )

                    if hasattr(res, "messages") and res.messages:
                        self._set_output_multiport(res.messages, out_port, exclude=None)
            except Exception as e:
                self.logger.error(f"Errore invocazione start_task_node: {e}")
    =}

    reaction(startup) {=
        try:
            self.current_task_node = self.data_model.get_node("Scheduler/Status/current_task")
            self.queue_length_node = self.data_model.get_node("Scheduler/Status/queue_length") 
            self.start_task_node = self.data_model.get_node("Scheduler/StartTask")

            def on_task_finished(*args, **kwargs):
                self.logger.info(f"<<< TASK SUCCESS: {self.current_task} motion finished.")
                self.current_task = ""
                
            if self.start_task_node:
                self.start_task_node.post_callback = on_task_finished
                
            self.logger.info("Scheduler Data Model loaded successfully.")
        except Exception as e:
            self.logger.error(f"Failed to load scheduler model: {e}")

        try:
            with open(self.scheduling_instance, 'r') as file:
                plan = json.load(file)
                self.task_queue = []
                for task in plan["jobs"][0]["tasks"]:
                    item = {"name": task["name"]}
                    if "parameters" in task and "tray_number" in task["parameters"]:
                        item["tray"] = task["parameters"]["tray_number"]
                    self.task_queue.append(item)
                        
                if self.queue_length_node: self.queue_length_node.value = len(self.task_queue)
        except Exception as e:
            self.logger.error(f"JSON Load Error: {e}")
    =}

    reaction(response_messages) -> channel_out {=
        for bank_index, message in response_messages.value:
            response = self.protocol_mng.handle_message(message)
            if response is not None:
                self._set_output_multiport([response], channel_out, exclude=None)
            
            updates = list(self.protocol_mng.get_update_messages())
            if updates:
                self._set_output_multiport(updates, channel_out, exclude=None)
                self.protocol_mng.clear_update_messages()
    =}

    reaction(monitoring_loop) -> channel_out {=
        if not self.connected:
            return
        if self.current_task == "":
            if self.task_queue:
                self.send_next_task(channel_out)
            elif self.current_task_node and self.current_task_node.value != "IDLE":
                self.logger.info("=== ALL TASKS COMPLETED ===")
                self.current_task_node.value = "IDLE"
                if self.queue_length_node: 
                    self.queue_length_node.value = 0
    =}
}