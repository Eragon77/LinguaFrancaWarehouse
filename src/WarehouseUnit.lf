target Python {
    files: [
        "python/warehouse_platform.py",
        "python/tray.py",
        "python/slot.py",
        "python/warehouse.py",
        "python/warehouse_controller.py",
        "python/cfg_engine.py" 
    ]
};

import FrostReactor from "../frost/src/lib/FrostReactor.lf"

preamble {=
    import sys
    import os
    
    sys.path.append(os.path.join(os.path.dirname(__file__), "python"))
    
    from warehouse import Warehouse
    from warehouse_controller import WarehouseController
=}

reactor WarehouseUnit extends FrostReactor {
    state pos_x = {= None =}
    state pos_y = {= None =}
    state tray_at_bay = {= None =}
    state is_busy_node = {= None =}
    state wh = {= None =}
    state wh_ctrl = {= None =}
    state prev_busy = {= False =}
    
    timer control_loop(0, 50 msec)

    reaction(startup) {=
        try:
            self.pos_x = self.data_model.get_node("Machine/Status/pos_x")
            self.pos_y = self.data_model.get_node("Machine/Status/pos_y")
            self.tray_at_bay = self.data_model.get_node("Machine/Status/tray_at_bay")
            self.is_busy_node = self.data_model.get_node("Machine/Status/Busy")
            
            self.wh = Warehouse()
            self.wh_ctrl = WarehouseController(self.wh)

            self.pos_x.value = self.wh.platform.curr_x
            self.pos_y.value = self.wh.platform.curr_y
            self.tray_at_bay.value = self.wh.tray_in_bay
            self.is_busy_node.value = False
            self.wh_ctrl.set_idle()
            self.prev_busy = False

            def do_extract(tray_id=0, **kwargs):
                if self.wh_ctrl.is_busy:
                    return False
                res = self.wh_ctrl.extract(int(tray_id))
                if res:
                    self.prev_busy = True
                    self.is_busy_node.value = True
                return res
                
            def do_sendback(**kwargs):
                if self.wh_ctrl.is_busy:
                    return False
                res = self.wh_ctrl.sendback()
                if res:
                    self.prev_busy = True
                    self.is_busy_node.value = True
                return res
                
            def do_fetch(**kwargs):
                if self.wh_ctrl.is_busy:
                    return False
                res = self.wh_ctrl.fetch_any_empty()
                if res:
                    self.prev_busy = True
                    self.is_busy_node.value = True
                return res

            def do_enqueue(tray_id=0, **kwargs):
                if self.wh_ctrl.is_busy:
                    return False
                res = self.wh_ctrl.enqueue(int(tray_id))
                if res:
                    self.prev_busy = True
                    self.is_busy_node.value = True
                return res

            self.data_model.get_node("Machine/ExtractTray").callback = do_extract
            self.data_model.get_node("Machine/SendBack").callback = do_sendback
            self.data_model.get_node("Machine/FetchAnyEmpty").callback = do_fetch
            self.data_model.get_node("Machine/Enqueue").callback = do_enqueue

        except Exception as e:
            self.logger.error(f"Startup failed: {e}")
    =}

    reaction (new_method_request) -> channel_out {=
        for bank_index, message in new_method_request.value:
            response = self.protocol_mng.handle_message(message)
            if response is not None:
                self._set_output_multiport([response], channel_out, exclude=None)
    =}

    reaction(control_loop) -> channel_out {=
            if not self.wh_ctrl: 
                return
            
            if not self.connected:
            return

            if self.wh_ctrl.is_busy:
                self.wh_ctrl.tick()

            currently_busy = self.wh_ctrl.is_busy

            if self.prev_busy and not currently_busy:
                self.logger.info("PHYSICAL MOVEMENT COMPLETED - NOTIFYING DATA MODEL")
                self.is_busy_node.value = False

            self.prev_busy = currently_busy
            
            self.pos_x.value = self.wh.platform.curr_x
            self.pos_y.value = self.wh.platform.curr_y
            self.tray_at_bay.value = self.wh.tray_in_bay
            
            updates = list(self.protocol_mng.get_update_messages())
            if updates:
                self._set_output_multiport(updates, channel_out, exclude=None)
                self.protocol_mng.clear_update_messages()
        =}
}